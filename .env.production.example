# =====================================================
# PredictNeed IA - variables d'environnement production
# Copiez ce fichier côté hébergeur et remplissez les valeurs réelles.
# Ne publiez jamais ce fichier avec des secrets remplis.
# =====================================================

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-generate-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=ton-domaine.fr,www.ton-domaine.fr
DJANGO_CSRF_TRUSTED_ORIGINS=https://ton-domaine.fr,https://www.ton-domaine.fr
PREDICTNEED_SITE_URL=https://ton-domaine.fr

# Base de données PostgreSQL
# Option 1, souvent fournie par Render/Railway/Scalingo/Fly :
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Option 2, si votre hébergeur fournit les champs séparés :
POSTGRES_DB=predictneed
POSTGRES_USER=predictneed
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=change-me
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Stripe - abonnement 99 euros / mois
STRIPE_SECRET_KEY=sk_live_change-me
STRIPE_PRICE_ID=price_change-me
STRIPE_WEBHOOK_SECRET=whsec_change-me
STRIPE_AUTOMATIC_TAX=False
PREDICTNEED_SUBSCRIPTION_NAME=PredictNeed IA Pro
PREDICTNEED_SUBSCRIPTION_PRICE_CENTS=9900
PREDICTNEED_SUBSCRIPTION_CURRENCY=eur
PREDICTNEED_SUBSCRIPTION_INTERVAL=month

# Email SMTP réel
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@ton-domaine.fr
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=PredictNeed IA <no-reply@ton-domaine.fr>
PREDICTNEED_CONTACT_EMAIL=contact@ton-domaine.fr

# Sécurité HTTPS
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Connecteurs externes optionnels
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

META_ADS_CLIENT_ID=
META_ADS_CLIENT_SECRET=
META_ADS_AUTH_URL=https://www.facebook.com/v20.0/dialog/oauth
META_ADS_TOKEN_URL=https://graph.facebook.com/v20.0/oauth/access_token

LINKEDIN_ADS_CLIENT_ID=
LINKEDIN_ADS_CLIENT_SECRET=

TIKTOK_ADS_CLIENT_ID=
TIKTOK_ADS_CLIENT_SECRET=
TIKTOK_ADS_AUTH_URL=
TIKTOK_ADS_TOKEN_URL=
TIKTOK_ADS_SCOPES=advertiser.read
